<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="local" type="System.Configuration.NameValueSectionHandler" />
    <section name="star" type="System.Configuration.NameValueSectionHandler" />
    <section name="vinil" type="System.Configuration.NameValueSectionHandler" />
    <section name="backlite" type="System.Configuration.NameValueSectionHandler" />
  </configSections>
  <local>
    <add key="name" value="Local" />
    <add key="code" value="LOCAL" />
    <add key="rate" value="6.5" />
  </local>
  <star>
    <add key="name" value="Star" />
    <add key="code" value="STAR" />
    <add key="rate" value="12" />
  </star>
  <vinil>
    <add key="name" value="vinil" />
    <add key="code" value="VINIL" />
    <add key="rate" value="25" />
  </vinil>
  <backlite>
    <add key="name" value="backlite" />
    <add key="code" value="BACKLITE" />
    <add key="rate" value="35" />
  </backlite>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>


  <appSettings>
    <add key="filepath" value="C:\\Program Files (x86)\\PrinterManager\\PrintedArea.log"/>
    <add key="jobFilepath" value="D:\\Work\\PrintJobs"/>
    <add key="billSavePath" value="D:\\Work\\AshokaGraphics\\Bills"/>
    <add key="billImageLogoPath" value="D:\\Work\\AshokaGraphichs\\PrintLogger\\Images\\ashoka1.jpg"/>
  </appSettings>
</configuration>