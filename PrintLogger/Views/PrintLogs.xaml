<Page x:Class="PrintLogger.Views.PrintLogs"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PrintLogger.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PrintLogs" DataContext="ViewModel.JobsViewModel">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="12*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="180*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="30*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="30*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="30*" />
            <ColumnDefinition Width="150*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="120*" />
        </Grid.ColumnDefinitions>
        <TextBox Name="searchTxtBox" Grid.Row="0" Grid.Column="0" FontSize="15"   VerticalAlignment="Center" Height="26" />
        <Button Grid.Row="0" Grid.Column="2" Content="Search" Background="#FF27AE61" Click="Search_Click" />
        <Button Grid.Row="0" Grid.Column="4" Content="Clear" Background="#FF36BCDC"  Click="Clear_Click"/>
        <Button Grid.Row="0" Grid.Column="6" Content="Refresh" Background="#FFE8A33E" Click="Refresh_Click"/>
        <DataGrid Name="DataGrid1" Grid.Row="2" Grid.ColumnSpan="8" ColumnHeaderHeight="40" AutoGenerateColumns="False" ItemsSource="{Binding}" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sr.No." Binding="{Binding Path=Id}"  IsReadOnly="True"></DataGridTextColumn>
                <DataGridTextColumn Header="Job Date" Binding="{Binding Path=JobDate}"  IsReadOnly="True"></DataGridTextColumn>
                <DataGridTextColumn Header="File Path" Binding="{Binding Path=FilePath}"  IsReadOnly="True"></DataGridTextColumn>
                <DataGridTextColumn Header="Percent Complete" Binding="{Binding Path=PercentComplete}"  IsReadOnly="True"></DataGridTextColumn>
                <DataGridTextColumn Header="Job Start time" Binding="{Binding Path=JobStartTime}"  IsReadOnly="True"></DataGridTextColumn>
                <DataGridTextColumn Header="Job End time" Binding="{Binding Path=JobEndTime}"  IsReadOnly="True"></DataGridTextColumn>
                <DataGridTextColumn Header="Time Required" Binding="{Binding Path=TimeRequired}"  IsReadOnly="True"></DataGridTextColumn>
            </DataGrid.Columns>
            
        </DataGrid>
        
        <Image  Grid.Row="2" Grid.Column="9" Source="..\Images\logo.png"/>
    </Grid>
</Page>
