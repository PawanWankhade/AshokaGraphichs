<Window x:Class="PrintLogger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrintLogger"
        mc:Ignorable="d" WindowState="Maximized"
        Title="PrintLogger v1.0" Background="#FF480657"  WindowStartupLocation="CenterScreen" Name="ParentWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="25*" />
            <RowDefinition Height="15*" />
            <RowDefinition Height="7*" />
            <RowDefinition Height="200*" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" />
            <ColumnDefinition Width="270*" />
            <ColumnDefinition Width="40*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="45*" />
            <ColumnDefinition Width="20*" />
        </Grid.ColumnDefinitions>
        <Image Source="Images\logo2.png" Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Left"></Image>
        <Button Grid.Row="2" Grid.Column="2" Content="Show Logs" Click="Button_Click"></Button>
        <Button Grid.Row="2"  Grid.Column="4" Content="Generate Bills" Click="Button_Click_1"></Button>
        <Separator Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Height="10" />
        <Frame x:Name="MainFrame" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="4" NavigationUIVisibility="Hidden"></Frame>
        <TextBlock x:Name="textblock1" Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="8" Text="Copyright © 2020-21 All rights reserved." Foreground="#FFB2ADAD" />
    </Grid>


</Window>
